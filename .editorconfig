# Editor whitespace conventions for every contributor and tool.
# https://editorconfig.org — supported natively by many editors and by CI-adjacent tooling.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
# Markdown uses trailing double-spaces for hard line breaks; keep them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{lock,lock.json}]
# Lockfiles are generated; do not hand-edit.
insert_final_newline = true
trim_trailing_whitespace = false
