{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/satellites-images/blob/main/specs/scene.schema.json",
  "title": "Satellite scene (normalized)",
  "type": "object",
  "required": [
    "providerId",
    "id",
    "collection",
    "acquiredAt",
    "access",
    "assets",
    "raw"
  ],
  "properties": {
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "string"
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "mission": {
      "type": [
        "string",
        "null"
      ]
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ]
    },
    "bbox": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 6
    },
    "cloudCoverPercent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "access": {
      "enum": [
        "open",
        "authentication-required",
        "payment-required",
        "unknown"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "href"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "raw": {
      "type": "object"
    }
  }
}
