{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/satellites-images/blob/main/specs/scene.schema.json",
  "title": "Satellite scene (normalized)",
  "$comment": "Canonical JSON uses camelCase. The Python and Rust packages serialize their native dataclasses/structs (snake_case) directly; JSON contracts are validated for the TypeScript package. See specs/README.md.",
  "type": "object",
  "required": [
    "providerId",
    "id",
    "collection",
    "acquiredAt",
    "access",
    "assets",
    "raw"
  ],
  "properties": {
    "providerId": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "collection": { "type": "string" },
    "acquiredAt": { "type": "string", "format": "date-time" },
    "mission": { "type": ["string", "null"] },
    "geometry": { "type": ["object", "null"] },
    "bbox": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 6
    },
    "cloudCoverPercent": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "gsdMeters": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "Ground sample distance in metres when the provider exposes gsd"
    },
    "coveragePercent": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Approximate bbox-overlap percentage of the requested AOI, 0-100"
    },
    "previewUrl": { "type": ["string", "null"] },
    "sourceUrl": { "type": ["string", "null"] },
    "access": {
      "enum": ["open", "authentication-required", "payment-required", "unknown"]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "href"],
        "properties": {
          "key": { "type": "string" },
          "href": { "type": "string" },
          "type": { "type": ["string", "null"] },
          "roles": { "type": "array", "items": { "type": "string" } },
          "access": {
            "enum": ["open", "authentication-required", "payment-required", "unknown"]
          }
        }
      }
    },
    "raw": { "type": "object" }
  }
}
