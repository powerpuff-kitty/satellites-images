{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/satellites-images/blob/main/specs/availability.schema.json",
  "title": "UTC observation availability summary",
  "$comment": "Canonical JSON uses camelCase (TypeScript contract). See specs/README.md.",
  "type": "object",
  "required": ["days", "months", "providers", "pagesScanned", "rawItems", "uniqueItems", "complete", "truncatedProviders"],
  "properties": {
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "count", "missions", "collections"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "count": { "type": "integer", "minimum": 0 },
          "missions": { "type": "object", "additionalProperties": { "type": "integer" } },
          "collections": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["month", "count", "daysWithObservations"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "count": { "type": "integer", "minimum": 0 },
          "daysWithObservations": { "type": "integer", "minimum": 0 },
          "missions": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pagesScanned", "rawItems", "uniqueItems", "hasMore"],
        "properties": {
          "id": { "type": "string" },
          "pagesScanned": { "type": "integer", "minimum": 0 },
          "rawItems": { "type": "integer", "minimum": 0 },
          "uniqueItems": { "type": "integer", "minimum": 0 },
          "matched": { "type": ["integer", "null"] },
          "hasMore": { "type": "boolean" }
        }
      }
    },
    "pagesScanned": { "type": "integer", "minimum": 0 },
    "rawItems": { "type": "integer", "minimum": 0 },
    "uniqueItems": { "type": "integer", "minimum": 0 },
    "complete": { "type": "boolean" },
    "truncatedProviders": { "type": "array", "items": { "type": "string" } },
    "erroredProviders": { "type": "array", "items": { "type": "string" } }
  }
}
